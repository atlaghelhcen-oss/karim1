---
import '../styles/global.css';
import { SITE } from '../site';
const { title, description, path = '', schema = [] } = Astro.props;
const url = SITE.url + path;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={url} /><link rel="icon" href="/favicon.svg" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:locale" content="fr_FR" /><meta property="og:url" content={url} />
  <meta property="og:image" content={SITE.url + '/iptv-smarters-pro-guide-4k.svg'} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;600;700&display=swap" rel="stylesheet" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
<header class="top"><div class="wrap">
  <a class="logo" href="/" aria-label="IPTV Smarters Pro France"><i></i>IPTV Smarters Pro</a>
  <nav aria-label="Navigation principale"><a href="/#tarifs">Code IPTV</a><a href="/#activation">Installation</a><a href="/#avis">Avis</a><a href="/#faq">FAQ</a><a href="/contact">Contact</a></nav>
  <a class="btn lemon" href="/#tarifs">Voir les offres</a>
</div></header>
<slot />
<footer><div class="wrap">
  <div class="cols">
    <div><h4>IPTV Smarters Pro France</h4><p>Le meilleur IPTV France en 4K : codes IPTV livrés par e-mail, support français 24/7 et garantie satisfait ou remboursé 30 jours.</p></div>
    <div><h4>Informations</h4><ul><li><a href="/mentions-legales">Mentions légales</a></li><li><a href="/politique-de-confidentialite">Confidentialité</a></li><li><a href="/conditions-generales-de-vente">CGV</a></li><li><a href="/politique-de-remboursement">Remboursement</a></li></ul></div>
    <div><h4>Support</h4><p><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />Réponse 24h/24, 7j/7</p></div>
  </div>
  <p>© {new Date().getFullYear()} {SITE.name}. Tous droits réservés.</p>
</div></footer>
</body></html>
